# EBTS 통합업무포털 — 환경변수 예시
# 실제 비밀값은 이 파일이 아니라 .env 에 넣고, .env 는 절대 커밋하지 않습니다.
# (루트 .gitignore 에 .env, .env.* 가 포함되어 있습니다.)

# ── 참조 MVP (이 저장소에 포함된 무의존성 Node 서버) ──
PORT=4000
# SQLite 파일 경로(미지정 시 portal/data/ebts.db)
EBTS_DB_PATH=./portal/data/ebts.db
# 시드 스크립트가 생성하는 테스트 계정 비밀번호(개발 전용)
EBTS_SEED_PW=Test1234!

# ── 프로덕션 목표(Supabase) 전환 시 사용할 값 (참고용) ──
# 클라이언트에 노출해도 되는 공개 값 (anon key)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 절대 클라이언트에 노출 금지 — 서버(Edge Function/API)에서만 사용
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# DATABASE_URL=postgres://...
