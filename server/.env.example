# 헌혈의 집 회원 인증 서버 환경 변수 예시
# 복사해서 server/.env 로 저장하면 npm start / npm run dev 때 자동으로 읽힌다. (.env 는 Git에 올리지 않는다)

# 실행 모드: development | production
NODE_ENV=development

# 접속 포트와 바인딩 주소 (0.0.0.0 이면 같은 와이파이의 휴대폰에서 http://PC-IP:3000 으로 접속 가능)
PORT=3000
HOST=0.0.0.0

# SQLite 회원 DB 파일 위치 (기본: server/data/app.db)
# DATABASE_PATH=/var/lib/red-ledger/app.db

# ── 운영(HTTPS) 배포 시 설정 ───────────────────────────
# 실제 서비스 주소. 다른 사이트에서 보낸 요청(CSRF)을 막는 기준이 된다.
# APP_ORIGIN=https://example.com

# 리버스 프록시(Nginx, 호스팅 로드밸런서) 뒤에서 실행하면 프록시 단계 수를 적는다. 예: 1
# TRUST_PROXY=1

# 쿠키 Secure 속성. 비우면 NODE_ENV=production 일 때 자동으로 true
# COOKIE_SECURE=true
